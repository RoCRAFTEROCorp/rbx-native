{
  "name": "rbx-native",
  "author": "rbx-native",
  "themes": [
    {
      "name": "rbx-native High contrast",
      "mode": "dark",
      "radius": 5,
      "radius.lg": 5,
      "colors": {
        "background": "#000000",
        "foreground": "#FFFFFF",
        "border": "#FFFFFF8C",
        "window.border": "#FFFFFF8C",
        "input.border": "#FFFFFF8C",
        "caret": "#FFFFFF",
        "muted.background": "#0B0B0C",
        "muted.foreground": "#B4B4BC",
        "popover.background": "#0B0B0C",
        "popover.foreground": "#FFFFFF",
        "overlay": "#000000B3",
        "accent.background": "#FFFFFF24",
        "accent.foreground": "#FFFFFF",
        "primary.background": "#9AA8FF",
        "primary.foreground": "#000000",
        "primary.hover.background": "#A4B1FF",
        "primary.active.background": "#8392E6",
        "secondary.background": "#000000",
        "secondary.foreground": "#D6D6DC",
        "secondary.hover.background": "#26262A",
        "secondary.active.background": "#333338",
        "switch.background": "#0B0B0C",
        "sidebar.background": "#000000",
        "sidebar.foreground": "#FFFFFF",
        "sidebar.border": "#FFFFFF8C",
        "sidebar.accent.background": "#FFFFFF24",
        "sidebar.accent.foreground": "#FFFFFF",
        "sidebar.primary.background": "#9AA8FF",
        "sidebar.primary.foreground": "#000000",
        "tab_bar.background": "#000000",
        "tab.background": "#000000",
        "tab.foreground": "#D6D6DC",
        "tab.active.background": "#000000",
        "tab.active.foreground": "#FFFFFF",
        "list.background": "#000000",
        "list.even.background": "#000000",
        "list.head.background": "#000000",
        "list.active.background": "#9AA8FF33",
        "list.active.border": "#9AA8FF",
        "table.background": "#000000",
        "table.head.foreground": "#D6D6DC",
        "table.row.border": "#FFFFFF8C",
        "danger.background": "#FF8F8F",
        "danger.foreground": "#000000",
        "ring": "#9AA8FF",
        "selection.background": "#9AA8FF4D",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#FFFFFF80",
        "scrollbar.thumb.hover.background": "#FFFFFFCC",
        "title_bar.background": "#000000",
        "title_bar.border": "#FFFFFF8C",
        "status_bar.background": "#000000",
        "status_bar.border": "#FFFFFF8C",
        "group_box.background": "#000000",
        "group_box.foreground": "#FFFFFF",
        "accordion.background": "#000000",
        "tiles.background": "#000000",
        "drop_target.background": "#9AA8FF40",
        "drag_border": "#9AA8FF"
      },
      "highlight": {
        "editor_background": "#000000",
        "syntax": {
          "attribute": { "color": "#D8E0FF" },
          "boolean": { "color": "#FFD58F" },
          "comment": { "color": "#C8C8D0" },
          "constant": { "color": "#FFD58F" },
          "constructor": { "color": "#A6E2FF" },
          "embedded": { "color": "#FFFFFF" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "function": { "color": "#A6E2FF" },
          "keyword": { "color": "#B8C6FF" },
          "link_text": { "color": "#A6E2FF", "font_style": "normal" },
          "link_uri": { "color": "#A6E2FF", "font_style": "italic" },
          "number": { "color": "#FFD58F" },
          "operator": { "color": "#E4E4EA" },
          "property": { "color": "#D8E0FF" },
          "punctuation": { "color": "#E4E4EA" },
          "string": { "color": "#A8F0B0" },
          "string.escape": { "color": "#A8F0B0" },
          "string.regex": { "color": "#A8F0B0" },
          "string.special": { "color": "#A8F0B0" },
          "string.special.symbol": { "color": "#A8F0B0" },
          "tag": { "color": "#FFBCD8" },
          "text.code.span": { "color": "#A8F0B0" },
          "text.literal": { "color": "#A8F0B0" },
          "title": { "color": "#FFD58F", "font_weight": 600 },
          "type": { "color": "#ECC2FF" },
          "variable": { "color": "#FFFFFF" },
          "variable.special": { "color": "#FFBCD8" }
        }
      }
    }
  ]
}
